# ElevenLabs: Settings → API Keys. Needs "ElevenAgents" read access at minimum.
ELEVENLABS_API_KEY=
# Agent → Settings → Agent ID (e.g. agent_xxx). Turn on Authentication for the agent.
ELEVENLABS_AGENT_ID=
# Settings → Webhooks → your post-call webhook → secret
ELEVENLABS_WEBHOOK_SECRET=
# Any long random string; also set as the x-tool-secret header on both tools.
# Generate one with: openssl rand -hex 32
TOOL_SECRET=

# Optional: shown on the home page
NEXT_PUBLIC_AGENT_PHONE_NUMBER=

# Optional: persistent storage (Vercel Marketplace → Upstash Redis adds these)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
